{
  "name": "filezy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:menuids": "node scripts/check-menuids.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node scripts/e2e/run.mjs",
    "build:e2e": "tauri build --no-bundle --features e2e && cargo build --example testcloud --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run check:menuids && npm run check && npm test && npm run build && npm run test:rust",
    "release:manifest": "node scripts/make-latest-json.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "svelte": "^5",
    "svelte-check": "^4.7.6",
    "typescript": "^5",
    "vite": "^6"
  }
}
