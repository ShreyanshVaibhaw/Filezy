{
  "name": "filezy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:menuids": "node scripts/check-menuids.mjs",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node scripts/e2e/run.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "verify": "npm run check:menuids && npm run check && npm test && npm run build && npm run test:rust",
    "release:manifest": "node scripts/make-latest-json.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5",
    "vite": "^6"
  }
}
